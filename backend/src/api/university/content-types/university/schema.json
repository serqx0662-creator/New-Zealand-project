{
  "kind": "collectionType",
  "collectionName": "universities",
  "info": {
    "singularName": "university",
    "pluralName": "universities",
    "displayName": "University"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "rating": {
      "type": "decimal"
    },
    "qsRank": {
      "type": "string"
    },
    "programsCount": {
      "type": "integer"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "country": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::country.country"
    },
    "programs": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::program.program"
    },
    "description": {
      "type": "text"
    },
    "about": {
      "type": "text"
    }
  }
}
